{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "config/**/*.ts",
    "models/**/*.ts",
    "routes/**/*.ts",
    "controller/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
